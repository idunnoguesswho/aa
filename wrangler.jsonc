// Cloudflare Workers config for aa.ekat.ca.
// This is a static-assets-only Worker: there is no "main" script, so Cloudflare
// serves the files in ./public directly from its edge (free, no server to run).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aa",
  "compatibility_date": "2026-09-25",

  // Everything in ./public is uploaded and served as-is.
  "assets": {
    "directory": "./public",
    // Serve /about from about.html, and /about/ from about/index.html.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get public/404.html with a real 404 status.
    "not_found_handling": "404-page"
  },

  // custom_domain: true makes Cloudflare create the DNS record and TLS
  // certificate for aa.ekat.ca automatically (ekat.ca is already on this account).
  "routes": [
    { "pattern": "aa.ekat.ca", "custom_domain": true }
  ],

  // Don't also publish on the *.workers.dev address - aa.ekat.ca is the only URL.
  "workers_dev": false,
  "preview_urls": false
}
